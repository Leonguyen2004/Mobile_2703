<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mobile_2703"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.MovieListActivity"
            android:exported="false"
            android:label="Phim Đang Chiếu"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".activity.MovieDetailActivity"
            android:exported="false"
            android:label="Chi Tiết Phim"
            android:parentActivityName=".activity.MovieListActivity" />

        <activity
            android:name=".activity.TheaterListActivity"
            android:exported="false"
            android:label="Rạp Chiếu Phim"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>