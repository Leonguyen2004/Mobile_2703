<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mobile_2703"
        tools:targetApi="31">

        <!-- ===================================================
             Entry point: redirect ngay sang SplashActivity
             =================================================== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Splash (1.5s) → HomeActivity -->
        <activity
            android:name=".SplashActivity"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.Mobile_2703" />

        <!-- Home hub -->
        <activity
            android:name=".activity.HomeActivity"
            android:exported="false"
            android:label="@string/home_toolbar_title" />

        <!-- Đăng nhập -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="Đăng Nhập"
            android:parentActivityName=".activity.HomeActivity" />

        <!-- Danh sách phim -->
        <activity
            android:name=".activity.MovieListActivity"
            android:exported="false"
            android:label="Phim Đang Chiếu"
            android:parentActivityName=".activity.HomeActivity" />

        <!-- Chi tiết phim -->
        <activity
            android:name=".activity.MovieDetailActivity"
            android:exported="false"
            android:label="Chi Tiết Phim"
            android:parentActivityName=".activity.MovieListActivity" />

        <!-- Danh sách rạp -->
        <activity
            android:name=".activity.TheaterListActivity"
            android:exported="false"
            android:label="Rạp Chiếu Phim"
            android:parentActivityName=".activity.HomeActivity" />

        <!-- Lịch chiếu -->
        <activity
            android:name=".activity.ShowtimeListActivity"
            android:exported="false"
            android:label="Lịch Chiếu"
            android:parentActivityName=".activity.HomeActivity" />

        <!-- Chọn ghế -->
        <activity
            android:name=".activity.SeatSelectionActivity"
            android:exported="false"
            android:label="Chọn Ghế"
            android:parentActivityName=".activity.ShowtimeListActivity" />

        <!-- Xác nhận đặt vé -->
        <activity
            android:name=".activity.BookingConfirmActivity"
            android:exported="false"
            android:label="Xác Nhận Đặt Vé"
            android:parentActivityName=".activity.SeatSelectionActivity" />

        <!-- Vé của tôi -->
        <activity
            android:name=".activity.MyTicketsActivity"
            android:exported="false"
            android:label="Vé Của Tôi"
            android:parentActivityName=".activity.HomeActivity" />

    </application>

</manifest>
